# App (public, inlined into the bundle at `eas update` time). Never put the OpenAI key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend (Supabase Edge Function secrets, set with `npx supabase secrets set`, not in the app)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-luna
